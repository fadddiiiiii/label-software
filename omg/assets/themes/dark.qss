/* ═══════════════════════════════════════════════════════════════════
 * OMG — Dark Theme Stylesheet (QSS)
 * Design tokens from SEC 04 of Implementation Proposal
 * ═══════════════════════════════════════════════════════════════════
 *
 * Color Palette:
 *   --bg-primary:    #0D0F14   (Main application background)
 *   --bg-panel:      #161A22   (Panels, cards, sidebars)
 *   --bg-steel:      #1E2533   (Table headers, toolbar backgrounds)
 *   --accent-cyan:   #00C9C8   (Primary interactive elements, active states)
 *   --accent-blue:   #3B82F6   (Secondary accents, links, info states)
 *   --accent-violet:  #7C3AED  (Branding accents, badges)
 *   --text-primary:  #E5E7EB   (Primary readable text)
 *   --text-muted:    #9CA3AF   (Secondary text, labels, captions)
 *   --border:        #374151   (All dividers and borders)
 *   --radius:        6px       (Uniform border radius)
 * ═══════════════════════════════════════════════════════════════════ */


/* ── GLOBAL ──────────────────────────────────────────────────────── */

QMainWindow, QDialog {
    background-color: #0D0F14;
    color: #E5E7EB;
}

QWidget {
    background-color: transparent;
    color: #E5E7EB;
    font-family: "Inter", "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 13px;
}


/* ── MENU BAR ────────────────────────────────────────────────────── */

QMenuBar {
    background-color: #161A22;
    color: #E5E7EB;
    border-bottom: 1px solid #374151;
    padding: 2px 0;
}

QMenuBar::item {
    padding: 6px 12px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #1E2533;
    color: #00C9C8;
}

QMenu {
    background-color: #161A22;
    border: 1px solid #374151;
    border-radius: 6px;
    padding: 4px 0;
}

QMenu::item {
    padding: 8px 24px 8px 16px;
    color: #E5E7EB;
}

QMenu::item:selected {
    background-color: #1E2533;
    color: #00C9C8;
}

QMenu::separator {
    height: 1px;
    background-color: #374151;
    margin: 4px 8px;
}


/* ── TOOLBAR ─────────────────────────────────────────────────────── */

QToolBar {
    background-color: #1E2533;
    border-bottom: 1px solid #374151;
    padding: 4px 8px;
    spacing: 4px;
}

QToolButton {
    background-color: transparent;
    color: #E5E7EB;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 6px 10px;
}

QToolButton:hover {
    background-color: #374151;
    border-color: #00C9C8;
}

QToolButton:pressed, QToolButton:checked {
    background-color: rgba(0, 201, 200, 0.15);
    border-color: #00C9C8;
    color: #00C9C8;
}


/* ── PANELS & CARDS ──────────────────────────────────────────────── */

QDockWidget {
    background-color: #161A22;
    color: #E5E7EB;
    border: 1px solid #374151;
    titlebar-close-icon: none;
}

QDockWidget::title {
    background-color: #1E2533;
    padding: 8px 12px;
    font-weight: 600;
    border-bottom: 1px solid #374151;
}

QFrame[frameShape="4"],   /* HLine */
QFrame[frameShape="5"] {  /* VLine */
    color: #374151;
}

QGroupBox {
    background-color: #161A22;
    border: 1px solid #374151;
    border-radius: 6px;
    margin-top: 16px;
    padding-top: 20px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 4px 12px;
    color: #9CA3AF;
}


/* ── BUTTONS ─────────────────────────────────────────────────────── */

QPushButton {
    background-color: #1E2533;
    color: #E5E7EB;
    border: 1px solid #374151;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 500;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #374151;
    border-color: #00C9C8;
    color: #00C9C8;
}

QPushButton:pressed {
    background-color: rgba(0, 201, 200, 0.2);
}

QPushButton:disabled {
    background-color: #0D0F14;
    color: #4B5563;
    border-color: #1E2533;
}

/* Primary action buttons */
QPushButton[class="primary"] {
    background-color: #00C9C8;
    color: #0D0F14;
    border: none;
    font-weight: 600;
}

QPushButton[class="primary"]:hover {
    background-color: #00B3B2;
    color: #0D0F14;
}

/* Danger / destructive buttons */
QPushButton[class="danger"] {
    background-color: transparent;
    color: #EF4444;
    border-color: #EF4444;
}

QPushButton[class="danger"]:hover {
    background-color: rgba(239, 68, 68, 0.15);
}


/* ── INPUTS ──────────────────────────────────────────────────────── */

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox {
    background-color: #0D0F14;
    color: #E5E7EB;
    border: 1px solid #374151;
    border-radius: 6px;
    padding: 8px 12px;
    selection-background-color: rgba(0, 201, 200, 0.3);
    selection-color: #E5E7EB;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #00C9C8;
    outline: none;
}

QLineEdit:disabled, QTextEdit:disabled {
    background-color: #161A22;
    color: #4B5563;
}

QComboBox {
    background-color: #0D0F14;
    color: #E5E7EB;
    border: 1px solid #374151;
    border-radius: 6px;
    padding: 8px 12px;
    min-width: 100px;
}

QComboBox:hover {
    border-color: #00C9C8;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #161A22;
    color: #E5E7EB;
    border: 1px solid #374151;
    border-radius: 6px;
    selection-background-color: #1E2533;
    selection-color: #00C9C8;
}


/* ── TABLES ──────────────────────────────────────────────────────── */

QTableView, QTreeView, QListView {
    background-color: #0D0F14;
    alternate-background-color: #161A22;
    color: #E5E7EB;
    border: 1px solid #374151;
    border-radius: 6px;
    gridline-color: #374151;
    selection-background-color: rgba(0, 201, 200, 0.15);
    selection-color: #00C9C8;
}

QHeaderView::section {
    background-color: #1E2533;
    color: #9CA3AF;
    border: none;
    border-right: 1px solid #374151;
    border-bottom: 1px solid #374151;
    padding: 8px 12px;
    font-weight: 600;
    font-size: 11px;
    text-transform: uppercase;
}


/* ── SCROLL BARS ─────────────────────────────────────────────────── */

QScrollBar:vertical {
    background-color: #0D0F14;
    width: 10px;
    margin: 0;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #374151;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4B5563;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: #0D0F14;
    height: 10px;
    margin: 0;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #374151;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #4B5563;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}


/* ── TABS ────────────────────────────────────────────────────────── */

QTabWidget::pane {
    background-color: #161A22;
    border: 1px solid #374151;
    border-top: none;
}

QTabBar::tab {
    background-color: #0D0F14;
    color: #9CA3AF;
    border: 1px solid #374151;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 8px 16px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #161A22;
    color: #00C9C8;
    border-bottom: 2px solid #00C9C8;
}

QTabBar::tab:hover:!selected {
    color: #E5E7EB;
    background-color: #1E2533;
}


/* ── PROGRESS BAR ────────────────────────────────────────────────── */

QProgressBar {
    background-color: #0D0F14;
    border: 1px solid #374151;
    border-radius: 6px;
    text-align: center;
    color: #E5E7EB;
    min-height: 20px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #00C9C8, stop:1 #3B82F6);
    border-radius: 5px;
}


/* ── STATUS BAR ──────────────────────────────────────────────────── */

QStatusBar {
    background-color: #161A22;
    color: #9CA3AF;
    border-top: 1px solid #374151;
    font-size: 12px;
}

QStatusBar::item {
    border: none;
}


/* ── TOOLTIPS ────────────────────────────────────────────────────── */

QToolTip {
    background-color: #1E2533;
    color: #E5E7EB;
    border: 1px solid #374151;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 12px;
}


/* ── LABELS (SPECIAL) ────────────────────────────────────────────── */

QLabel[class="heading"] {
    font-size: 18px;
    font-weight: 700;
    color: #E5E7EB;
}

QLabel[class="subheading"] {
    font-size: 14px;
    font-weight: 500;
    color: #9CA3AF;
}

QLabel[class="accent"] {
    color: #00C9C8;
    font-weight: 600;
}

QLabel[class="badge-violet"] {
    background-color: rgba(124, 58, 237, 0.2);
    color: #7C3AED;
    border-radius: 10px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
}


/* ── SPLITTERS ───────────────────────────────────────────────────── */

QSplitter::handle {
    background-color: #374151;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

QSplitter::handle:hover {
    background-color: #00C9C8;
}
