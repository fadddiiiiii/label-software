// FILE: omg/core/formula.lark
// PEG grammar for the OMG binding formula mini-language
// SEC 06 of Technical Specification
// ═══════════════════════════════════════════════════════════

start : expr

expr : func_call | concat | ref | string | number

concat : expr "+" expr

func_call : FNAME "(" arglist ")"

arglist : expr ("," expr)*

ref : "{" CNAME "}"                   // {ColumnName} — reference to a data column

string : ESCAPED_STRING

number : NUMBER

FNAME : "upper" | "lower" | "trim" | "pad_left" | "pad_right"
      | "slice" | "replace" | "date_fmt" | "if_empty"

%import common.CNAME
%import common.ESCAPED_STRING
%import common.NUMBER
%import common.WS
%ignore WS
